{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:base",
    "docker:enableMajor"
  ],
  "automerge": false,
  "schedule": ["on the 1st and 3rd day instance on sunday after 9pm"],
  "prHourlyLimit": 6,
  "prConcurrentLimit": 50,
  "commitBodyTable": true,
  "semanticCommits": true,
  "separateMajorMinor": false,
  "dependencyDashboard": true,
  "labels": ["dependency-upgrade"],
  "reviewers": ["team:infra-maintenance-dri"],  
  "prBodyNotes": [
    "{{#if isMajor}}:warning: THIS IS A MAJOR VERSION UPDATE :warning:{{/if}}",
    "Before merging, *always* check with the release notes if any other changes need to be done."
  ],
  "docker": {
    "pruneStaleBranches": false
  },
  "major": {
    "enabled": true
  },
  "minor": {
    "enabled": true
  },
  "patch": {
    "enabled": true
  },
  "packageRules": [
    {
      "languages": ["python"],
      "packagePatterns": [".*"],
      "addLabels": ["group:python"]
    },
    {
      "languages": ["golang"],
      "packagePatterns": [".*"],
      "addLabels": ["group:golang"]
    },
    {
      "datasources": ["terraform-provider"],
      "packagePatterns": [".*"],
      "addLabels": ["group:terraform"],
      "extends": ["schedule:monthly"]
    },
    {
      "datasources": ["docker"],
      "packagePatterns": ["kubectl"],
      "addLabels": ["app:kubectl"]
    },
    {
      "datasources": ["docker"],
      "packagePatterns": ["vault"],
      "addLabels": ["group:vault"]
    },
    {
      "datasources": ["docker"],
      "packagePatterns": [
        "gcr.io/ci-30-162810/.*",
        "gcr.io/camunda-internal/.*",
        "gcr.io/camunda-public/.*"
      ],
      "enabled": false
    }
  ],
  "regexManagers": [
    {
      "fileMatch": ["^Dockerfile$"],
      "matchStrings": [
        "renovate: datasource=(?<datasource>.*?) depName=(?<depName>.*?)( versioning=(?<versioning>.*?))?\\s(ARG|ENV) .*?_VERSION=(?<currentValue>.*)\\s"
      ],
      "versioningTemplate": "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}"
    }
  ]
}
