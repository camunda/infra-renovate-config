{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:recommended",
    "docker:enableMajor",
    ":automergeDisabled",
    ":semanticCommits",
    ":dependencyDashboard",
    ":enablePreCommit",
  ],
  schedule: ["every weekend"],
  platformAutomerge: false,
  prHourlyLimit: 6,
  prConcurrentLimit: 20,
  commitBodyTable: true,
  separateMajorMinor: false,
  prBodyNotes: [
    "{{#if isMajor}}:warning: THIS IS A MAJOR VERSION UPDATE :warning:{{/if}}",
    "Before merging, *always* check with the release notes if any other changes need to be done.",
  ],
  major: {
    enabled: true,
    addLabels: ["upgrade:major"],
  },
  minor: {
    enabled: true,
    addLabels: ["upgrade:minor"],
  },
  patch: {
    enabled: true,
    addLabels: ["upgrade:patch"],
  },
  kubernetes: {
    managerFilePatterns: ["/\\.y.?ml$/"],
  },
  kustomize: {
    managerFilePatterns: ["/kustomization\\.y.?ml$/"],
  },
  vulnerabilityAlerts: {
    labels: ["security"],
    enabled: true
  },
  lockFileMaintenance: {
    addLabels: ["automerge"],
    schedule: "every weekend",
    automerge: true,
    enabled: true
  },
  packageRules: [
    // Don't close update PRs in case there're connectivity issues or requests limit with a Docker registry
    {
      matchCategories: ["docker"],
      pruneStaleBranches: false
    },
    // limit the PR creation for the Renovate pre-commit hook (it's released very frequently)
    {
      matchPackageNames: ["renovatebot/pre-commit-hooks"],
      matchUpdateTypes: ["patch"],
      enabled: false,
    },
    {
      matchPackageNames: ["renovatebot/pre-commit-hooks"],
      schedule: ["on Saturday"],
    },
    // Use only stable/LTS versions of NodeJS (even numbers): 18, 20, ...
    {
      matchPackageNames: ["node"],
      allowedVersions: "/^[1-9][0,2,4,6,8].*$/",
    },
    {
      matchCategories: ["python"],
      groupName: "Python dependencies",
      matchPackageNames: ["!httpx"], // version 0.28.0 broke functionality for camunda/infra-github-exporter (Nov 2024) and needs to be treated separately
      addLabels: ["group:python"],
    },
    {
      matchCategories: ["golang"],
      groupName: "Go dependencies",
      postUpdateOptions: ["gomodTidy"],
      addLabels: ["group:golang"],
    },
    {
      matchCategories: ["js"],
      groupName: "JavaScript dependencies",
      addLabels: ["group:javascript"],
    },
    {
      matchManagers: ["github-actions"],
      addLabels: ["group:github-actions", "component:ci"],
    },
    {
      matchPackageNames: ["/infra-actions-runner/"],
      groupName: "GitHub Self-Hosted runners",
      addLabels: ["group:github-runners", "component:ci"],
    },
    {
      matchDatasources: ["docker"],
      matchDepNames: ["/.*/dockerhub/library/docker$/"],
      groupName: "Docker",
      addLabels: ["group:docker", "component:ci"],
    },
    {
      matchPackageNames: ["/velero/.+/"],
      groupName: "Velero-related components",
      addLabels: ["group:velero"],
    },
    {
      matchPackageNames: ["vault", "/hashicorp/vault/"],
      groupName: "vault",
      addLabels: ["group:vault"],
    },
    {
      matchPackageNames: ["/prom/.*/"],
      groupName: "Prometheus-related components",
      addLabels: ["group:prometheus"],
    },
    // Apps
    {
      matchPackageNames: ["/goharbor/"],
      groupName: "Harbor components",
      addLabels: ["app:harbor", "component:repo"],
    },
    {
      matchPackageNames: ["/cert-manager/"],
      groupName: "cert-manager components",
      addLabels: ["app:cert-manager", "component:ingress"],
    },
    {
      matchPackageNames: [
        "/argo-cd/",
        "/argocd/",
        "/dex/",
        "!/argocd-operator/"
      ],
      groupName: "ArgoCD components",
      addLabels: ["app:argocd", "component:gitops"],
    },
    {
      matchPackageNames: ["/argocd-operator/"],
      groupName: "ArgoCD Operator",
      addLabels: ["app:argocd-operator", "component:gitops"],
    },
    {
      matchPackageNames: ["/eck-operator/"],
      groupName: "Elasticsearch Operator components",
      addLabels: ["app:eck", "component:gitops"],
    },
    {
      matchPackageNames: ["/jenkins/jenkins/"],
      groupName: "Jenkins components",
      addLabels: ["app:jenkins", "component:ci"],
    },
    {
      matchDatasources: ["jenkins-plugins"],
      groupName: "Jenkins plugins",
      addLabels: ["app:jenkins", "component:ci"],
    },
    {
      matchPackageNames: [ "hadolint", "hadolint/hadolint" ],
      groupName: "Hadolint",
    },
    {
      matchPackageNames: [ "markdownlint-cli2", "DavidAnson/markdownlint-cli2" ],
      groupName: "markdownlint-cli2",
    },
    // disable updates to `latest` versions of our CI images, we use pinned versions
    {
      matchDatasources: ["docker"],
      matchPackageNames: [
        "/europe-west1-docker.pkg.dev/ci-30-162810/main/.*/",
      ],
      allowedVersions: "!/.*vlatest$/",
    },
    // Custom versioning for CI images with Chrome version prefix (e.g., 78v1.0.33 or 112v1.0.33)
    {
      matchPackageNames: [
        "europe-west1-docker.pkg.dev/ci-30-162810/main/chrome",
      ],
      versioning: "regex:^(?<compatibility>\\d+)v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)$",
    },
    // Terraform AWS modules
    {
      matchDatasources: ["terraform-module"],
      matchPackageNames: ["/terraform-aws-modules.*/"],
      addLabels: ["group:terraform"],
      groupName: "Terraform AWS modules",
      schedule: [
        "every 2 weeks on Saturday and Sunday",
      ],
    },
    // Terraform major provider updates
    {
      matchDatasources: ["terraform-provider"],
      addLabels: ["group:terraform"],
      schedule: [
        "every 2 weeks on Saturday and Sunday",
      ]
    },
    // Terraform minor & patch provider updates
    {
      matchUpdateTypes: ["minor", "patch"],
      matchDatasources: ["terraform-provider"],
      addLabels: ["group:terraform", "automerge"],
      groupName: "Terraform providers",
      automerge: true,
      schedule: [
        "every 2 weeks on Saturday and Sunday",
      ]
    },
    // We can't upgrade to next CentOS major version,
    // e.g. in https://github.com/camunda/camunda-docker-ci-base-centos
    {
      separateMajorMinor: true,
      matchPackageNames: [
        "centos",
      ],
    },
    {
      matchUpdateTypes: ["major"],
      matchPackageNames: [
        "centos",
      ],
      enabled: false,
    },
    {
      matchUpdateTypes: ["major", "minor"],
      matchPackageNames: [
        "kubernetes/kubectl",
        "kubernetes/kubernetes",
        "/autoscaling/cluster-autoscaler/"
      ],
      enabled: false,
    },
    // GitHub Actions
    {
      matchUpdateTypes: ["minor", "patch"],
      matchManagers: ["github-actions"],
      addLabels: ["automerge"],
      automerge: true,
    },
    // Automerge composite actions digest updates from infra-global-github-actions
    // Grouped by function for easier maintenance. Add new subfolders to the appropriate group.
    // Group: fossa (license compliance)
    {
      matchUpdateTypes: ["digest"],
      matchDepNames: ["camunda/infra-global-github-actions"],
      matchJsonata: ["$contains(replaceString, 'camunda/infra-global-github-actions/fossa/')"],
      groupName: "infra-global-github-actions fossa",
      additionalBranchPrefix: "fossa-",
      commitMessageTopic: "infra-global-github-actions (fossa) digest",
      commitMessageExtra: "to {{newDigestShort}}",
      prBodyNotes: [
        "This PR updates the digest for **fossa-related composite actions** from [camunda/infra-global-github-actions](https://github.com/camunda/infra-global-github-actions/tree/main/fossa).",
      ],
      addLabels: ["automerge"],
      automerge: true,
    },
    // Group: ci-tooling (CI/Build related actions)
    {
      matchUpdateTypes: ["digest"],
      matchDepNames: ["camunda/infra-global-github-actions"],
      matchJsonata: ["$contains(replaceString, 'camunda/infra-global-github-actions/build-docker-image@')"],
      groupName: "infra-global-github-actions ci-tooling",
      additionalBranchPrefix: "ci-tooling-",
      commitMessageTopic: "infra-global-github-actions (ci tooling) digest",
      commitMessageExtra: "to {{newDigestShort}}",
      prBodyNotes: [
        "This PR updates the digest for **ci-tooling composite actions** from [camunda/infra-global-github-actions](https://github.com/camunda/infra-global-github-actions).",
      ],
      addLabels: ["automerge"],
      automerge: true,
    },
    // Group: infra-utilities (auth, PR management, team utilities)
    {
      matchUpdateTypes: ["digest"],
      matchDepNames: ["camunda/infra-global-github-actions"],
      matchJsonata: [
        "$contains(replaceString, 'camunda/infra-global-github-actions/generate-github-app-token-from-vault-secrets@') \
         or $contains(replaceString, 'camunda/infra-global-github-actions/teams/infra/')"
      ],
      groupName: "infra-global-github-actions infra-utilities",
      additionalBranchPrefix: "infra-utilities-",
      commitMessageTopic: "infra-global-github-actions (infra utilities) digest",
      commitMessageExtra: "to {{newDigestShort}}",
      prBodyNotes: [
        "This PR updates the digest for **infra-utilities composite actions** (auth, PR management, team utilities) from [camunda/infra-global-github-actions](https://github.com/camunda/infra-global-github-actions).",
      ],
      addLabels: ["automerge"],
      automerge: true,
    },
    // Patches
    // Those are tested packages, and we know that they follow the semver convention,
    // but it's fine to have candidate packages to test before move them to minor section.
    {
      matchUpdateTypes: ["patch"],
      matchPackageNames: [
        "/infra-actions-runner/",
        "/actionlint/",
        "actions/checkout",
        "actions/setup-go",
        "actions/setup-python",
        "adrienverge/yamllint",
        "/aio-libs/aiohttp/",
        "/alertmanager/",
        "/amazon/aws-for-fluent-bit/",
        "/aquasecurity/trivy/",
        "/argocd/",
        "argoproj/argo-cd",
        "/autoscaling/cluster-autoscaler/",
        "aws/aws-cli",
        "/blackbox-exporter/",
        "/busybox/",
        "/camunda-ci-dashboard/",
        "/camunda_infra-k8s-webhook/",
        "/cloud-sql-proxy/",
        "/conftest/",
        "/curlimages/curl/",
        "/docker/",
        "docker.elastic.co/eck/eck-operator",
        "doitintl/kube-no-trouble",
        "eclipse-temurin",
        "/external-dns/",
        "/external-secrets/",
        "europe-west1-docker.pkg.dev/camunda-internal/main/camunda-internal_argocd_sidecar",
        "europe-west1-docker.pkg.dev/ci-30-162810/main/centos",
        "fluent/fluent-bit",
        "ghcr.io/actions/actions-runner",
        "/goharbor//",
        "golang",
        "google-cloud-bigquery",
        "google-cloud-pubsub",
        "google-cloud-storage",
        "google/cloud-sdk",
        "/grafana/",
        "hashicorp/setup-terraform",
        "/hashicorp/vault/",
        "/helm/",
        "/infra-channel-slack-bot/",
        "/infra-dri-bot/",
        "/ingress-nginx/controller/",
        "/jetstack/cert-manager/",
        "/jimmidyson/configmap-reload/",
        "jinja2",
        "/json-exporter/",
        "jonasvinther/medusa",
        "/keycloak/",
        "kube-prometheus-stack",
        "kubernetes/kubectl",
        "kubernetes/kubernetes",
        "/kube-state-metrics/",
        "/kubecost-cost-model/",
        "mikefarah/yq",
        "node",
        "/opencost/opencost/",
        "/pandas/",
        "/peimanja/artifactory_exporter/",
        "peter-evans/create-pull-request",
        "/postgres-exporter/",
        "/pre-commit/",
        "/prom/.+/",
        "psf/black",
        "public.ecr.aws/gravitational/teleport-ent-distroless",
        "PyCQA/pylint",
        "python/cpython",
        "pyyaml",
        "quay.io/mittwald/kubernetes-replicator",
        "requests",
        "slack-bolt",
        "/sonatype/nexus3/",
        "teleport",
        "hashicorp/terraform",
        "/terraform-aws-modules\/.+/",
        "terraform-docs/terraform-docs",
        "terraform-linters/tflint",
        "tj-actions/changed-files",
        "/velero/.+/",
        "/vouch/vouch-proxy/",
        "wiz-kubernetes-integration",
      ],
      addLabels: ["automerge"],
      automerge: true,
    },
    // Minor versions
    // Those are tested packages, and we know that they follow the semver convention,
    // but it's fine to have candidate packages to test before move them to minor section.
    {
      matchUpdateTypes: ["minor"],
      matchPackageNames: [
        "/infra-actions-runner/",
        "actions/checkout",
        "actions/setup-go",
        "actions/setup-python",
        "adrienverge/yamllint",
        "/alertmanager/",
        "/amazon/aws-for-fluent-bit/",
        "aws/aws-cli",
        "/blackbox-exporter/",
        "/busybox/",
        "/camunda-ci-dashboard/",
        "/cloud-sql-proxy/",
        "/curlimages/curl/",
        "/docker/",
        "/docker.elastic.co/eck/eck-operator/",
        "/external-dns/",
        "europe-west1-docker.pkg.dev/ci-30-162810/main/centos",
        "fluent/fluent-bit",
        "ghcr.io/actions/actions-runner",
        "golang",
        "google-cloud-bigquery",
        "google-cloud-storage",
        "google/cloud-sdk",
        "/grafana/",
        "/jimmidyson/configmap-reload/",
        "jinja2",
        "jonasvinther/medusa",
        "/infra-channel-slack-bot/",
        "/infra-dri-bot/",
        "kube-prometheus-stack",
        "/kube-state-metrics/",
        "/kubecost-cost-model/",
        "mikefarah/yq",
        "node",
        "open-policy-agent/conftest",
        "peter-evans/create-pull-request",
        "/pre-commit/",
        "/prom/.*/",
        "psf/black",
        "public.ecr.aws/gravitational/teleport-ent-distroless",
        "PyCQA/pylint",
        "pyyaml",
        "quay.io/mittwald/kubernetes-replicator",
        "requests",
        "teleport",
        "/terraform-aws-modules\/.+/",
        "terraform-docs/terraform-docs",
        "terraform-linters/tflint",
        "tj-actions/changed-files",
      ],
      addLabels: ["automerge"],
      automerge: true,
    },
    {
      matchUpdateTypes: ["patch"],
      matchCategories: ["python", "golang", "java"],
      addLabels: ["automerge"],
      automerge: true
    },
    {
      matchUpdateTypes: ["minor"],
      matchCategories: ["python", "golang", "java"],
      matchPackageNames: ["!httpx"], // version 0.28.0 broke functionality for camunda/infra-github-exporter (Nov 2024)
      addLabels: ["automerge"],
      automerge: true
    },
    // Create PRs and automerge mentioned components afterward
    // Those are tested packages
    {
      matchUpdateTypes: ["major"],
      matchPackageNames: [
        "actions/checkout",
        "actions/setup-go",
        "actions/setup-python",
        "google/cloud-sdk",
        "/gspread/",
        "node",
        "/pre-commit/.+/",
        "psf/black",
        "pytz",
        "tj-actions/changed-files",
      ],
      addLabels: ["automerge"],
      automerge: true,
    },
    {
      "matchUpdateTypes": ["major", "minor", "patch"],
      "matchManagers": ["pre-commit"],
      "groupName": "pre-commit hooks",
      "addLabels": ["automerge"],
      "automerge": true
    },
    // For known GitHub repositories that use GitHub tags/releases of format
    // "v1.2.3" and where the asdf plugin ignores the "v" prefix, we also tell
    // Renovate to ignore it via extractVersion when updating .tool-version file
    {
      matchFileNames: ["**/.tool-versions", "**/*.tf", "**/update.sh", "Dockerfile"],
      matchPackageNames: [
        "aquasecurity/trivy",
        "hadolint/hadolint",
        "hashicorp/terraform",
        "helm/helm",
        "jonasvinther/medusa",
        "koalaman/shellcheck",
        "open-policy-agent/conftest",
        "pre-commit/pre-commit",
        "yannh/kubeconform",
      ],
      extractVersion: "^v(?<version>.*)$",
    },

    // Version bumps of certain sensible dependencies need to match the underlying version bump
    // e.g. a minor kubernetes bump shouldn't result in a "chore" commitType but rather a "feat".
    // This avoids unexpected surprises when automerges on patch releases are enabled for packages which consume these dependencies.
    {
      matchPackageNames: [
        "helm/helm",
        "kubernetes/kubectl",
        "kubernetes-sigs/kustomize",
      ],
      matchUpdateTypes: ["patch"],
      semanticCommitType: "fix", // indicates a patch version bump
    },
    {
      matchPackageNames: [
        "helm/helm",
        "kubernetes/kubectl",
        "kubernetes-sigs/kustomize",
      ],
      matchUpdateTypes: ["minor"],
      semanticCommitType: "feat", // indicates a minor version bump
    },
    {
      matchPackageNames: [
        "helm/helm",
        "kubernetes/kubectl",
        "kubernetes-sigs/kustomize",
      ],
      matchUpdateTypes: ["major"],
      semanticCommitType: "feat!", // the exlamation mark indicates a breaking change, hence a major version bump
    },

    // For the kustomize GitHub repo that uses GitHub tags/releases of format
    // "kustomize/v1.2.3" and where the asdf plugin ignores this prefix, we also
    // tell Renovate to ignore it via extractVersion when updating .tool-version
    {
      matchFileNames: [".tool-versions", "Dockerfile"],
      matchPackageNames: [
        "kubernetes-sigs/kustomize",
      ],
      extractVersion: "^kustomize/v(?<version>.*)$",
    },
    {
      matchPackageNames: ["kubernetes/kubectl"],
      extractVersion: "^kubernetes-(?<version>.*)$",
    },
    // Custom regex versioning scheme
    // Very useful for monorepos that prefix the release version with a component name
    // e.g. actions/actions-runner-controller -> gha-runner-scale-set-x.x.x
    {
      matchPackageNames: [
        "actions/actions-runner-controller",
      ],
      versioning: "regex:^(?<compatibility>.*)-?(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)?$"
    },
    // Wiz CNAPP integration Helm updates
    {
      "matchDatasources": ["helm"],
      "matchDepNames": ["wiz-kubernetes-integration"],
      "registryUrls": ["https://wiz-sec.github.io/charts"]
    },
    // Disable updating Docker image tags in Wiz upstream.
    // It's handled in the Helm chart upgrade by the previous rule.
    {
      "matchDatasources": ["docker"],
      "ignorePaths": [
        "kustomize/base/wiz/eks/wiz-upstream.yml",
        "kustomize/base/wiz/gke/wiz-upstream.yml"
      ]
    },
    // Force all Teleport major updates to use custom manager and datasource
    // Separate Major and Minor for teleport,
    // otherwise 18.x upgrade will always be suggested instead of 17.x.x minor/patches,
    // even if server is at version 17.x.x
    {
      "matchManagers": ["terraform"],
      "matchPackageNames": ["gravitational/teleport"],
      "separateMajorMinor": true
    },
    // Disable terraform manager for teleport provider entirely (custom manager handles it)
    {
      "matchManagers": ["terraform"],
      "matchPackageNames": ["gravitational/teleport"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    },
    {
      "matchPackageNames": [ "camunda/infra-global-github-actions" ],
      "matchUpdateTypes": [ "digest" ],
      "changelogUrl": "https://github.com/camunda/infra-global-github-actions/compare/{{currentDigest}}..{{newDigest}}"
    },
    {
      // TODO: This is related to https://github.com/camunda/team-infrastructure/issues/954
      "matchPackageNames": ["helm"],
      "allowedVersions": "<4.0.0"
    },
    // GKE-specific rules
    // Common rule: separate major/minor from patch
    {
      matchPackageNames: ["gke"],
      separateMajorMinor: true,
      separateMinorPatch: true,
    },
    // PATCH updates: separate PR per cluster, automerge
    {
      matchPackageNames: ["gke"],
      matchFileNames: ["camunda-int/**"],
      matchUpdateTypes: ["patch"],
      groupName: "gke patch (camunda-int)",
      groupSlug: "gke",
      commitMessageTopic: "gke patch (camunda-int)",
      additionalBranchPrefix: "camunda-int-",
      // Allow GKE patch upgrades to auto-merge by bypassing TF plan check
      addLabels: ["component:gke", "automerge", "tf-plan-reviewed"],
      automerge: true,
    },
    {
      matchPackageNames: ["gke"],
      matchFileNames: ["camunda-pub/**"],
      matchUpdateTypes: ["patch"],
      groupName: "gke patch (camunda-pub)",
      groupSlug: "gke",
      commitMessageTopic: "gke patch (camunda-pub)",
      additionalBranchPrefix: "camunda-pub-",
    // Allow GKE patch upgrades to auto-merge by bypassing TF plan check
      addLabels: ["component:gke", "automerge", "tf-plan-reviewed"],
      automerge: true,
    },
    // MINOR updates: single PR for all clusters, no automerge
    {
      matchPackageNames: ["gke"],
      matchUpdateTypes: ["minor"],
      groupName: "gke minor (all clusters)",
      groupSlug: "gke",
      commitMessageTopic: "gke minor (all clusters)",
      addLabels: ["component:gke"],
      automerge: false,
    },
  ],
  // The following INFRA_* secrets are defined in Renovate App Settings for the camunda GitHub organization
  // https://developer.mend.io/github/camunda/-/settings
  hostRules: [
    {
      matchHost: "https://europe-west1-docker.pkg.dev/v2/ci-30-162810/main",
      authType: "Basic",
      token: "{{ secrets.INFRA_CAMUNDA_CI_GAR_TOKEN }}",
    },
    {
      matchHost: "https://europe-west1-docker.pkg.dev/v2/camunda-internal/main",
      authType: "Basic",
      token: "{{ secrets.INFRA_CAMUNDA_INTERNAL_GAR_TOKEN }}",
    },
    {
      matchHost: "https://europe-west1-docker.pkg.dev/v2/camunda-public/main",
      authType: "Basic",
      token: "{{ secrets.INFRA_CAMUNDA_PUBLIC_GAR_TOKEN }}",
    },
    {
      matchHost: "https://registry.camunda.cloud",
      hostType: "docker",
      authType: "Basic",
      token: "{{ secrets.INFRA_CAMUNDA_PUBLIC_HARBOR_TOKEN }}",
    },
  ],
  registryAliases: {
    // make renovate resolve images via the upstream DockerHub registry instead of pull-through caches
    "463214588456.dkr.ecr.eu-central-1.amazonaws.com/dockerhub": "registry-1.docker.io",
    "europe-west1-docker.pkg.dev/ci-30-162810/dockerhub": "registry-1.docker.io"
  },
  customManagers: [
    // for dependency versions in the Terraform code (like Terraform version itself)
    {
      managerFilePatterns: ["/\.tf$/"],
      customType: "regex",
      matchStrings: [
        "renovate: datasource=(?<datasource>.*?) depName=(?<depName>.*?)( versioning=(?<versioning>.*?))?\\s.*=\\s*\\\"(?<currentValue>.*)\\\"\\s"
      ],
      versioningTemplate: "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}"
    },
    {
      managerFilePatterns: ["/^Dockerfile$/"],
      customType: "regex",
      matchStrings: [
        "renovate: datasource=(?<datasource>.*?) depName=(?<depName>.*?)( versioning=(?<versioning>.*?))?\\s(ARG|ENV) .*?_VERSION=(?<currentValue>.*)\\s",
      ],
      versioningTemplate: "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}",
    },
    // For Teleport version (from custom datasource)
    // different rules are necessary for terraform and asdf/update.sh files
    // see customDatasources.teleport in this file
    {
      "customType": "regex",
      "managerFilePatterns": ["/\.tool-versions$/", "/update.sh$/"],
      "matchStrings": [
        "renovate-teleport:\\s.*[ =](?<currentValue>.*)\\s"
      ],
      "depNameTemplate": "teleport",
      "datasourceTemplate": "custom.teleport",
      "versioningTemplate": "semver"
    },
    {
      "customType": "regex",
      "managerFilePatterns": ["/\.tf$/"],
      "matchStrings": [
        "teleport\\s*=\\s*\\{[\\s\\S]*?version\\s*=\\s*[\"']~?>?\\s*(?<currentValue>[^\"'\\s]+)[\"'][\\s\\S]*?\\}"
      ],
      "depNameTemplate": "teleport",
      "datasourceTemplate": "custom.teleport",
      "versioningTemplate": "semver"
    },
    // for asdf-vm.org tool versions
    {
      managerFilePatterns: ["/\.tool-versions$/"],
      customType: "regex",
      matchStrings: [
        "renovate: datasource=(?<datasource>.*?) depName=(?<depName>.*?)( versioning=(?<versioning>.*?))?( extractVersion=(?<extractVersion>.*?))?\\s.* (?<currentValue>.*)\\s"
      ],
      versioningTemplate: "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}",
    },
    // for update scripts
    {
      managerFilePatterns: ["/update.sh$/"],
      customType: "regex",
      matchStrings: [
        "renovate: datasource=(?<datasource>.*?) depName=(?<depName>.*?)( packageName=(?<packageName>.*?))?( registryUrl=(?<registryUrl>.*?))?( versioning=(?<versioning>.*?))?\\s.*=(?<currentValue>.*)\\s"
      ],
      versioningTemplate: "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}"
    },
    // YAML files
    {
      managerFilePatterns: ["/\.y.?ml$/"],
      customType: "regex",
      matchStrings: [
        // for bumping image versions of GHA self-hosted runners
        "renovate: datasource=(?<datasource>.*?)( versioning=(?<versioning>.*?))?\\s.*?image: (?<depName>.*?):(?<currentValue>.*)\\s",
        // default
        "renovate: datasource=(?<datasource>.*?) depName=(?<depName>.*?)( versioning=(?<versioning>.*?))?\\s.* (?<currentValue>.*)\\s",
      ],
      versioningTemplate: "{{#if versioning}}{{{versioning}}}{{else}}semver{{/if}}"
    },
    // GKE versions
    {
      customType: "regex",
      managerFilePatterns: ["/\.tf$/"],
      matchStrings: [
        "#\\s*renovate:\\s*datasource=custom\\.gke-(?<channel>rapid|regular|stable|extended)\\n\\s*\\S+\\s*=\\s*\"(?<currentValue>[0-9]+\\.[0-9]+\\.[0-9]+-gke\\.[0-9]+)\""
      ],
      depNameTemplate: "gke",
      datasourceTemplate: "custom.gke-{{{channel}}}",
      versioningTemplate: "regex:^(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)-gke\\.(?<build>\\d+)$"
    }
  ],
  customDatasources: {
    // GKE release channel datasources
    "gke-rapid": {
      "defaultRegistryUrlTemplate": "https://camunda.github.io/infra-renovate-config/datasources/gke-rapid.json",
      "format": "json"
    },
    "gke-regular": {
      "defaultRegistryUrlTemplate": "https://camunda.github.io/infra-renovate-config/datasources/gke-regular.json",
      "format": "json"
    },
    "gke-stable": {
      "defaultRegistryUrlTemplate": "https://camunda.github.io/infra-renovate-config/datasources/gke-stable.json",
      "format": "json"
    },
    // Teleport version datasource
    teleport: {
      // Latest version for us == current one used in Camunda Teleport SaaS:
      // curl -s https://camunda.teleport.sh/webapi/ping | jq -r '.server_version'
      "defaultRegistryUrlTemplate": "https://camunda.teleport.sh/webapi/ping",
      "transformTemplates": [
        "{\"releases\": [{\"version\": $$.server_version}]}"
      ]
    }
  }
}
