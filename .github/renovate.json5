{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: [
    "config:recommended",
    ":automergeDisabled",
    ":semanticCommits",
    ":dependencyDashboard",
    ":enablePreCommit",
  ],
  schedule: ["every weekend"],
  platformAutomerge: false,
  packageRules: [
    {
      matchUpdateTypes: ["minor", "patch"],
      matchManagers: ["pre-commit"],
      automerge: true,
    },
  ]
}
